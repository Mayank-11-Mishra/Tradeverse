# Local-only configuration. Do not commit broker tokens. Enter broker tokens at runtime.
DATABASE_URL=sqlite:///./data/trading.db
# Optional. If set, also enter APP_LOCAL_TOKEN in the frontend Settings page.
APP_LOCAL_TOKEN=
# WARNING: Live trading cannot be enabled from the UI unless explicitly permitted here.
ALLOW_LIVE_TRADING=no
ALLOW_MOCK_BROKER=yes
